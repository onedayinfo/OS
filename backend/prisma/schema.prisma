// Modelo de dados do Sistema de OS — ver docs/superpowers/specs/2026-09-07-sistema-os-design.md §4.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  INTERNAL
  CLIENT
}

enum UserRole {
  ADMIN
  AGENT
  MANAGER
  CONTACT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketOrigin {
  EMAIL
  PORTAL
  MANUAL
}

enum CommentVisibility {
  INTERNAL
  PUBLIC
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  COMMENT
  EMAIL_IN
  EMAIL_OUT
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  type         UserType
  role         UserRole
  clientId     String?
  active       Boolean   @default(true)
  inviteToken  String?   @unique
  inviteSentAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client           Client?         @relation(fields: [clientId], references: [id])
  ticketsRequested Ticket[]        @relation("TicketRequester")
  ticketsAssigned  Ticket[]        @relation("TicketAssignee")
  comments         TicketComment[]
  events           TicketEvent[]
  attachments      Attachment[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  cnpj         String?
  emailDomains String[]
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users   User[]
  tickets Ticket[]

  @@map("clients")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("categories")
}

model SlaPolicy {
  priority  TicketPriority @id
  hours     Int
  updatedAt DateTime       @updatedAt

  @@map("sla_policies")
}

model Ticket {
  id              String         @id @default(cuid())
  number          String         @unique
  title           String
  description     String
  clientId        String?
  requesterId     String?
  categoryId      String?
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assigneeId      String?
  origin          TicketOrigin
  equipment       String?
  needsTriage     Boolean        @default(false)
  slaDueAt        DateTime?
  slaBreachNotifiedAt DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client        Client?         @relation(fields: [clientId], references: [id])
  requester     User?           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee      User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category      Category?       @relation(fields: [categoryId], references: [id])
  comments      TicketComment[]
  events        TicketEvent[]
  attachments   Attachment[]
  inboundEmails InboundEmail[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([categoryId])
  @@map("tickets")
}

model TicketComment {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  visibility CommentVisibility
  createdAt  DateTime          @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  type      TicketEventType
  data      Json
  actorId   String?
  createdAt DateTime        @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_events")
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String?
  commentId    String?
  filename     String
  storedPath   String
  mime         String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([commentId])
  @@map("attachments")
}

model InboundEmail {
  id         String   @id @default(cuid())
  messageId  String   @unique
  ticketId   String?
  fromEmail  String
  subject    String
  receivedAt DateTime
  headers    Json

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("inbound_emails")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Counter {
  year  Int @id
  value Int @default(0)

  @@map("counters")
}

model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}
