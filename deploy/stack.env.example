# Variáveis do stack do Portainer (portainer-stack.yml).
# Copie os pares NOME=valor para a aba "Environment variables" do stack, ou
# salve como stack.env ao lado do compose se usar o método "Repository".
# NÃO comite valores reais.

# --- Domínio do sistema (o que muda por cliente) ---
# Mesmo valor nos dois. Sem barra no final. Deve casar o hostname configurado
# no túnel do Cloudflare.
APP_URL=https://os.SEU_DOMINIO.com.br
PORTAL_URL=https://os.SEU_DOMINIO.com.br

# --- Cloudflare Tunnel ---
# Token do túnel criado no painel Zero Trust (Networks > Tunnels > Create).
# No túnel, adicione um Public Hostname: <APP_URL> -> HTTP -> frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=cole-o-token-aqui

# --- Imagens ---
# Tag publicada no Docker Hub (onedayinformatica/os-backend, onedayinformatica/os-frontend).
OS_TAG=0.8.1

# --- Criptografia dos segredos das Configurações (OBRIGATÓRIO a partir da 0.2.0) ---
# Resend, S3, aparência e backup agora são configurados em /app/config (aba só
# para ADMIN). Os segredos ficam criptografados no banco com esta chave. Sem
# ela o sistema sobe, mas não deixa salvar segredos pela UI.
# Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Banco ---
POSTGRES_USER=os
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=os

# --- Segredos ---
# Gere cada um com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-32-bytes-hex
JWT_REFRESH_SECRET=troque-outros-32-bytes-hex

# Cookie do refresh (padrão já serve para o túnel: mesma origem + HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Admin inicial (criado no 1º boot; idempotente) ---
SEED_ADMIN_EMAIL=admin@SEU_DOMINIO.com.br
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin

# --- E-mail (Resend) — LEGADO / opcional ---
# A partir da 0.2.0 o recomendado é configurar em /app/config > aba E-mail.
# Estas variáveis seguem funcionando como fallback enquanto o banco não tiver
# o valor correspondente.
RESEND_API_KEY=
# Segredo do webhook de e-mail de entrada (validação HMAC).
RESEND_INBOUND_SECRET=
MAIL_FROM=suporte@SEU_DOMINIO.com.br

# --- Armazenamento de anexos — LEGADO / opcional ---
# Padrão: disco (volume `uploads`). Para usar um bucket S3/R2/MinIO, configure
# em /app/config > aba Armazenamento. `STORAGE_PATH` continua valendo para o
# driver de disco.
# STORAGE_PATH=/app/uploads
