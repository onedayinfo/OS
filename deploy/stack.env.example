# Variáveis do stack do Portainer (portainer-stack.yml).
# Copie os pares NOME=valor para a aba "Environment variables" do stack, ou
# salve como stack.env ao lado do compose se usar o método "Repository".
# NÃO comite valores reais.

# --- Domínio do sistema (o que muda por cliente) ---
# Mesmo valor nos dois. Sem barra no final.
APP_URL=https://os.SEU_DOMINIO.com.br
PORTAL_URL=https://os.SEU_DOMINIO.com.br

# --- Imagens ---
# Tag publicada no Docker Hub (onedayinfo/os-backend, onedayinfo/os-frontend).
OS_TAG=0.1.0

# --- Portas locais (o proxy reverso aponta para elas) ---
BACKEND_PORT=3001
FRONTEND_PORT=3000

# --- Banco ---
POSTGRES_USER=os
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=os

# --- Segredos ---
# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-32-bytes-hex
JWT_REFRESH_SECRET=troque-outros-32-bytes-hex

# Cookie do refresh. Mesmo domínio + HTTPS: lax / true (padrão).
# Domínios separados: none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Admin inicial (criado no 1º boot; idempotente) ---
SEED_ADMIN_EMAIL=admin@SEU_DOMINIO.com.br
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin

# --- E-mail (Resend) — opcional; sem isso o sistema roda mas não envia e-mail ---
RESEND_API_KEY=
# Segredo do webhook de e-mail de entrada (validação HMAC).
RESEND_INBOUND_SECRET=
MAIL_FROM=suporte@SEU_DOMINIO.com.br
