# Variáveis do stack do Portainer (portainer-stack.yml).
#
# Método "Repository" no Portainer: este arquivo é carregado automaticamente
# como env do stack quando fica ao lado do compose. Preencha os valores e NÃO
# comite segredos reais — troque cada TROQUE_* antes de subir.
# (Referência comentada: deploy/stack.env.example.)

# --- Domínio do sistema (o que muda por cliente) ---
# Mesmo valor nos dois. Sem barra no final. Deve casar o hostname do túnel.
APP_URL=https://os.SEU_DOMINIO.com.br
PORTAL_URL=https://os.SEU_DOMINIO.com.br

# --- Cloudflare Tunnel ---
# Token do túnel (Zero Trust > Networks > Tunnels). Public Hostname:
# <APP_URL> -> HTTP -> frontend:3000
CLOUDFLARE_TUNNEL_TOKEN=TROQUE_TOKEN_DO_TUNEL

# --- Imagens ---
OS_TAG=0.11.0

# --- Criptografia dos segredos das Configurações (OBRIGATÓRIO) ---
# Resend, S3, aparência e backup são configurados em /app/config (aba só ADMIN).
# Os segredos ficam criptografados no banco com esta chave. Sem ela o sistema
# sobe, mas a UI não salva segredos (usa só o fallback das vars de e-mail).
# Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=TROQUE_BASE64_DE_32_BYTES

# --- Banco ---
POSTGRES_USER=os
POSTGRES_PASSWORD=TROQUE_SENHA_FORTE
POSTGRES_DB=os

# --- Segredos de auth ---
# Gere cada um com: openssl rand -hex 32
JWT_ACCESS_SECRET=TROQUE_32_BYTES_HEX
JWT_REFRESH_SECRET=TROQUE_OUTROS_32_BYTES_HEX

# Cookie do refresh (padrão já serve para o túnel: mesma origem + HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Admin inicial (criado no 1º boot; idempotente) ---
SEED_ADMIN_EMAIL=admin@SEU_DOMINIO.com.br
SEED_ADMIN_PASSWORD=TROQUE_SENHA_DO_ADMIN

# --- E-mail (Resend) — LEGADO / opcional ---
# Recomendado: configurar em /app/config > aba E-mail. Estas vars seguem como
# fallback enquanto o banco não tiver o valor correspondente.
RESEND_API_KEY=
RESEND_INBOUND_SECRET=
MAIL_FROM=suporte@SEU_DOMINIO.com.br
