# Banco de dados
DATABASE_URL="postgresql://os:os@localhost:5432/os?schema=public"

# Credenciais do container Postgres (usadas pelo docker-compose; default: os/os/os)
POSTGRES_USER=os
POSTGRES_PASSWORD=os
POSTGRES_DB=os

# API
PORT=3001
APP_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000

# Frontend (Next.js) — URL pública da API, DEVE terminar em /api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Autenticação
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
# Cookie do refresh: dev usa lax/false (http://localhost).
# Produção cross-origin (app e API em domínios diferentes): COOKIE_SAMESITE=none e COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# E-mail (Resend)
RESEND_API_KEY=
RESEND_INBOUND_SECRET=troque-este-segredo-inbound
# MAIL_FROM deve ser suporte@<seu-dominio>
MAIL_FROM="suporte@exemplo.com.br"

# Armazenamento de anexos
STORAGE_PATH=./uploads

# Seed do administrador inicial
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
